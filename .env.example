# Application
FLASK_APP=app.py
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here
HOST=127.0.0.1
PORT=5002

# Render PostgreSQL
# Use Render's Internal Database URL for the API service.
DATABASE_URL=postgresql://user:password@host:5432/database
DB_SSLMODE=require

# Static frontend -> API
# Local direct-open index.html can use http://127.0.0.1:5002.
# Render Static Site should set API_BASE_URL to the deployed API service URL.
API_BASE_URL=http://127.0.0.1:5002
CORS_ORIGINS=http://127.0.0.1:5002,http://localhost:5002,null

# Email (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
